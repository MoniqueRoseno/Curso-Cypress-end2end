    cy.get('.shopping_cart_badge').should('have.text', '1');
  // Vai para o carrinho 
  cy.irParaCarrinho();
  // Checkout completo 
  cy.realizarCheckout('comprador_1');
  // Valida página de sucesso (
  cy.validarCheckoutCompleto();
  });
  it('Adicionar dois produtos no carrinho e realizar checkout completo', () => {
    // Garante que estamos na página de produtos
    cy.url().should('include', '/inventory.html');  
    // Adiciona 1 item usando fixture
    cy.selecionarProduto('produto1', 'produto2');
