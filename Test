describe('Login Tests', () => {
  it('Login Válido Usuário standard_user', () => {
    cy.loginSauce();

    //Valição
    cy.url().should('include', '/inventory.html');
	cy.get('.title').should('have.text', 'Products');
  });

  it('Login Inválido - Usuário padrão com senha errada', () => {
    // Navigate to the login page
    cy.visit('https://www.saucedemo.com/');
    cy.get('[data-test="username"]').should('be.visible').type('standard_user');
    cy.get('[data-test="password"]').should('be.visible').type('wrong_password', { log: false });
    cy.get('[data-test="login-button"]').click();     
    // Validação mensagem de erro
    cy.get('[data-test="error"]').should('be.visible')
      .and('contain.text', 'Epic sadface')
      .and('contain.text', 'do not match any user');
    // Continua na página de login
    cy.url().should('eq', 'https://www.saucedemo.com/');
  });
    
});

describe('Compra Completa - SauceDemo', () => {
    beforeEach(() => {
    cy.loginSauce()
  })
  it('Adicionar um produto no carrinho e realizar checkout completo', () => {
